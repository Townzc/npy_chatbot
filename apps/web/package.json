  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "4.7.0",
    "openapi-typescript": "7.9.1",
    "typescript": "5.9.3",
    "vite": "7.1.12"
  }
}
